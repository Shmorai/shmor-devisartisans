  "faqs": [
    {
      "q": "DevisArtisans est-il gratuit ?",
      "a": "Oui. Nos guides sont gratuits, et publier votre projet chez nos partenaires pour recevoir des devis l’est aussi."
    },
    {
      "q": "Comment DevisArtisans est-il rémunéré ?",
      "a": "Certains liens sont des liens d’affiliation : un partenaire peut nous verser une commission lorsque vous publiez un projet chez lui. Cela ne change rien au prix que vous payez."
    },
    {
      "q": "Les artisans sont-ils vérifiés ?",
      "a": "Les artisans sont des entreprises indépendantes inscrites chez nos partenaires. Nous vous recommandons de vérifier vous-même leur SIRET, leur assurance et leurs qualifications."
    },
    {
      "q": "Dans quelles régions ?",
      "a": "Dans toute la France métropolitaine, Corse comprise. Consultez la page de votre région pour des conseils adaptés."
    }
  ],
